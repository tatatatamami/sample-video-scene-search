<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VideoSceneSearch</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NU1903: suppress package vulnerability audit warnings for preview/alpha packages.
         These packages are in preview and may have known vulnerabilities reported by NuGet audit.
         Remove this suppression once stable GA versions are available and the packages are upgraded.
         NU1605: suppress downgrade warnings from preview transitive dependency resolution. -->
    <NoWarn>$(NoWarn);NU1903;NU1605</NoWarn>
    <UserSecretsId>b0dc7863-5683-44ef-94d1-82ed3c1dd591</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Agent Framework hosting — provides AgentHost, AddFoundryResponses, MapFoundryResponses -->
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" Version="1.11.1-preview.260625.1" />
    <!-- Foundry SDK — provides AIProjectClient and AsAIAgent -->
    <PackageReference Include="Azure.AI.Projects" Version="2.1.0-beta.3" />
    <!-- MCP C# SDK — provides McpClient, HttpClientTransport, McpClientTool (: AIFunction) -->
    <PackageReference Include="ModelContextProtocol.Core" Version="1.4.0" />
  </ItemGroup>

</Project>
