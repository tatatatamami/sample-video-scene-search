@page
@model IndexModel
@{
    ViewData["Title"] = "動画シーン検索";
}

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="container">
        <header>
            <h1>🎬 動画シーン検索</h1>
        </header>

        <main>
            <section class="search-section">
                <h2>シーン検索</h2>
                <div class="search-form">
                    <input type="text" id="queryInput" placeholder="検索キーワードを入力してください（例：会議のシーン、製品デモ）" />
                    <button id="searchButton">検索</button>
                </div>
                <div id="loadingIndicator" class="loading" style="display: none;">
                    <p>検索中...</p>
                </div>
            </section>

            <h2 class="results-heading">検索結果</h2>
            <div class="content-layout">
                <section class="results-section">
                    <div id="resultsContainer">
                        <p class="no-results">検索結果がここに表示されます</p>
                    </div>
                </section>

                <aside class="video-section" style="display: none;">
                    <div class="video-container">
                        <video id="videoPlayer" controls>
                            <p>お使いのブラウザは動画タグをサポートしていません。</p>
                        </video>
                        <div class="video-info">
                            <h3 id="videoTitle"></h3>
                            <p id="videoDescription"></p>
                        </div>
                    </div>
                </aside>
            </div>
        </main>
    </div>

    <script>
        // Video mapping will be loaded from API
        let videoMapping = {};

        const queryInput = document.getElementById('queryInput');
        const searchButton = document.getElementById('searchButton');
        const loadingIndicator = document.getElementById('loadingIndicator');
        const resultsContainer = document.getElementById('resultsContainer');
        const videoSection = document.querySelector('.video-section');
        const videoPlayer = document.getElementById('videoPlayer');
        const videoTitle = document.getElementById('videoTitle');
        const videoDescription = document.getElementById('videoDescription');

        // Load video mapping on page load
        async function loadVideoMapping() {
            try {
                const response = await fetch('/api/video-mapping');
                if (response.ok) {
                    videoMapping = await response.json();
                } else {
                    // Fallback to sample videos
                    videoMapping = {
                        'video1': {
                            title: 'Sample Video 1',
                            file: 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4'
                        },
                        'video2': {
                            title: 'Sample Video 2',
                            file: 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ElephantsDream.mp4'
                        }
                    };
                }
            } catch (error) {
                console.error('Error loading video mapping:', error);
            }
        }

        // Initialize
        loadVideoMapping();

        searchButton.addEventListener('click', performSearch);
        queryInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                performSearch();
            }
        });


        async function performSearch() {
            const query = queryInput.value.trim();
            if (!query) {
                alert('検索キーワードを入力してください');
                return;
            }

            searchButton.disabled = true;
            loadingIndicator.style.display = 'block';
            resultsContainer.innerHTML = '<p class="no-results">検索中...</p>';

            try {
                const response = await fetch('/api/scene-search', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ query: query })
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const data = await response.json();
                displayResults(data);
            } catch (error) {
                console.error('Error:', error);
                const errMsg = document.createElement('p');
                errMsg.className = 'error';
                errMsg.textContent = `エラーが発生しました: ${error.message}`;
                resultsContainer.innerHTML = '';
                resultsContainer.appendChild(errMsg);
            } finally {
                searchButton.disabled = false;
                loadingIndicator.style.display = 'none';
            }
        }

        function displayResults(data) {
            try {
                if (!data || !data.scenes || data.scenes.length === 0) {
                    resultsContainer.innerHTML = '<p class="no-results">検索結果が見つかりませんでした</p>';
                    return;
                }

                resultsContainer.innerHTML = '';

                // Display summary header
                const summaryDiv = document.createElement('div');
                summaryDiv.className = 'scene-summary';
                summaryDiv.innerHTML = `
                    <h3>該当シーン: ${data.scenes.length}件</h3>
                `;
                resultsContainer.appendChild(summaryDiv);

                // Display scene results
                const scenesHeader = document.createElement('h3');
                scenesHeader.textContent = 'シーン候補';
                scenesHeader.style.marginTop = '2rem';
                resultsContainer.appendChild(scenesHeader);

                data.scenes.forEach((scene, index) => {
                    const sceneCard = createSceneCard(scene, index);
                    resultsContainer.appendChild(sceneCard);
                });
            } catch (error) {
                console.error('Error displaying results:', error);
                const errMsg = document.createElement('p');
                errMsg.className = 'error';
                errMsg.textContent = `結果の表示中にエラーが発生しました: ${error.message}`;
                resultsContainer.innerHTML = '';
                resultsContainer.appendChild(errMsg);
            }
        }

        function createSceneCard(scene, index) {
            const card = document.createElement('div');
            card.className = 'scene-card';

            // Determine confidence level badge
            let confidenceClass = 'confidence-medium';
            let confidenceLabel = 'Medium';
            if (scene.confidence >= 0.8) {
                confidenceClass = 'confidence-high';
                confidenceLabel = 'High';
            } else if (scene.confidence < 0.6) {
                confidenceClass = 'confidence-low';
                confidenceLabel = 'Low';
            }

            card.innerHTML = `
                <div class="scene-header">
                    <div class="scene-title">
                        <strong>シーン ${index + 1}</strong>
                        ${scene.videoId ? `<span class="scene-video-title">${escapeHtml(videoMapping[scene.videoId]?.title || scene.videoId)}</span>` : ''}
                        ${scene.videoId ? `<span class="video-id">ID: ${escapeHtml(scene.videoId)}</span>` : ''}
                    </div>
                    <span class="confidence-badge ${confidenceClass}">
                        信頼度: ${confidenceLabel} (${(scene.confidence * 100).toFixed(0)}%)
                    </span>
                </div>
                <div class="scene-body">
                    <div class="scene-timestamp">
                        <strong>Timestamp:</strong> ${escapeHtml(scene.start)} - ${escapeHtml(scene.end)}
                    </div>
                    ${scene.mode || scene.location || scene.tags || scene.actions ? `
                        <div class="scene-metadata">
                            ${scene.mode ? `<div class="metadata-item"><strong>Mode:</strong> <span class="tag tag-mode">${escapeHtml(scene.mode)}</span></div>` : ''}
                            ${scene.location ? `<div class="metadata-item"><strong>Location:</strong> <span class="tag tag-location">${escapeHtml(scene.location)}</span></div>` : ''}
                            ${scene.tags ? `<div class="metadata-item"><strong>Tags:</strong> ${scene.tags.split(',').map(t => '<span class="tag tag-info">' + escapeHtml(t.trim()) + '</span>').join(' ')}</div>` : ''}
                            ${scene.actions ? `<div class="metadata-item"><strong>Actions:</strong> ${scene.actions.split(',').map(a => '<span class="tag tag-action">' + escapeHtml(a.trim()) + '</span>').join(' ')}</div>` : ''}
                        </div>
                    ` : ''}
                    ${scene.description || scene.evidence ? `
                        <div class="scene-description">
                            <strong>Description:</strong> ${escapeHtml(scene.description || scene.evidence)}
                        </div>
                    ` : ''}
                    ${scene.evidence && scene.description !== scene.evidence ? `
                        <div class="scene-evidence">
                            <strong>根拠:</strong> ${escapeHtml(scene.evidence)}
                        </div>
                    ` : ''}
                </div>
                ${scene.videoId ? `
                <div class="scene-actions">
                    <button class="play-button" data-video-id="${escapeHtml(scene.videoId)}" 
                            data-start="${scene.startSeconds}"
                            data-end="${scene.endSeconds}"
                            data-title="${escapeHtml(scene.title || `シーン ${index + 1}`)}">
                        ▶️ 動画を再生
                    </button>
                </div>
                ` : ''}
            `;

            const playButton = card.querySelector('.play-button');
            if (playButton) {
                playButton.addEventListener('click', () => {
                    playVideo(scene.videoId, scene.startSeconds, scene.endSeconds, scene.title || `シーン ${index + 1}`, scene.description || scene.evidence);
                });
            }

            return card;
        }

        // Store the current end time for auto-pause
        let currentEndTime = null;
        let timeUpdateHandler = null;

        function playVideo(videoId, startSec, endSec, title, description) {
            const videoInfo = videoMapping[videoId];

            if (!videoInfo) {
                alert(`動画ID "${videoId}" の情報が見つかりません。videomapping.json に設定を追加してください。`);
                return;
            }

            const videoUrl = videoInfo.file || videoInfo;

            // Remove previous timeupdate handler if exists
            if (timeUpdateHandler) {
                videoPlayer.removeEventListener('timeupdate', timeUpdateHandler);
            }

            // Set end time for auto-pause
            currentEndTime = endSec;

            // Create new timeupdate handler for auto-pause at end time
            timeUpdateHandler = () => {
                if (currentEndTime && videoPlayer.currentTime >= currentEndTime) {
                    videoPlayer.pause();
                    videoDescription.textContent = `${description} (シーン終了: ${formatTime(currentEndTime)}で自動停止)`;
                }
            };
            videoPlayer.addEventListener('timeupdate', timeUpdateHandler);

            // Show loading message
            videoTitle.textContent = `読み込み中: ${videoInfo.title || title}`;
            videoDescription.textContent = `${formatTime(startSec)} - ${formatTime(endSec)} のシーンを再生中...`;
            videoSection.style.display = 'block';

            // Set video source with timestamp hint for faster seeking
            videoPlayer.src = videoUrl + '#t=' + startSec;
            videoTitle.textContent = videoInfo.title || title;

            // Wait for enough data to be loaded
            videoPlayer.addEventListener('canplay', () => {
                videoPlayer.currentTime = startSec;
                videoPlayer.play().catch(() => {});
            }, { once: true });

            // Error handler
            videoPlayer.addEventListener('error', (e) => {
                console.error('Video error:', e);
                console.error('Video error code:', videoPlayer.error?.code);
                console.error('Video error message:', videoPlayer.error?.message);
                videoDescription.textContent = '動画の読み込みに失敗しました。ファイルが存在するか確認してください。';
            }, { once: true });

            // Start loading the video
            videoPlayer.load();
        }

        function formatTime(seconds) {
            const mins = Math.floor(seconds / 60);
            const secs = Math.floor(seconds % 60);
            return `${mins}:${secs.toString().padStart(2, '0')}`;
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    </script>
</body>
</html>
